# 이 파일을 .env로 복사해 값을 채운다. .env는 git이 무시한다.

# 테넌트 저장 파일 암호화 키(32바이트 base64). 처음 한 번 만들고 계속 같은 값을 쓴다.
# 잃으면 등록 테넌트를 복호화할 수 없다. 만드는 방법은 README "Docker로 실행" 참고.
CPI_TENANT_STORE_KEY=

# true: 미리보기만(대상에 쓰지 않음). 미리보기를 확인한 뒤에만 false로 바꾸고 재기동한다.
CPI_TRANSPORT_READ_ONLY=true

# 매핑 파일. 비우면 치환하지 않는다(값이 원본 그대로 간다).
# 쓰려면 local/mapping.yml을 만든 뒤 /config/mapping.yml로 지정한다(./local 폴더가 컨테이너의 /config로 연결된다).
CPI_TRANSPORT_MAPPINGFILE=
